<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.presspeech.maintainer-release</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/libexec/presspeech-release-worker</string>
  </array>
  <key>QueueDirectories</key>
  <array>
    <string>__HOME__/Library/Application Support/PresspeechMaintainer/releases/requests</string>
  </array>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>5</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Presspeech-maintainer-release.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Presspeech-maintainer-release.log</string>
</dict>
</plist>
