#!/bin/bash
set -uo pipefail
umask 077

export HOME=/Users/rcourtman
export PATH=/Users/rcourtman/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin

run_release_action() {
  local checkout="$1"
  local requested_action="$2"

  cd "${checkout}"
  # Keep the interpreter explicit so the LaunchAgent never asks LaunchServices
  # to decide how a release entry point should be opened.
  case "${requested_action}" in
    patch) /bin/bash ./ship-swift.sh ;;
    minor) /bin/bash ./ship-swift.sh --minor ;;
    major) /bin/bash ./ship-swift.sh --major ;;
    version:*) /bin/bash ./ship-swift.sh --version "${requested_action#version:}" ;;
    cask-only:*) /bin/bash ./ship-swift.sh --cask-only "${requested_action#cask-only:}" ;;
    *) return 2 ;;
  esac
}

resolved_exit_code() {
  local observed_status="$1"
  local fallback_status="$2"

  if [[ "${observed_status}" -ne 0 ]]; then
    printf '%s\n' "${observed_status}"
  else
    printf '%s\n' "${fallback_status}"
  fi
}

self_test_release_actions() (
  set -e
  local scratch action_log expected_log
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/presspeech-release-action-self-test.XXXXXX")"
  trap 'rm -rf -- "${scratch}"' EXIT
  action_log="${scratch}/actions.log"
  expected_log="${scratch}/expected.log"

  # These expressions belong to the generated fake, not this worker.
  # shellcheck disable=SC2016
  printf '%s\n' \
    '#!/bin/bash' \
    'printf "%s" "$#" >>"${PRESSPEECH_RELEASE_ACTION_LOG}"' \
    'for argument in "$@"; do printf " <%s>" "${argument}" >>"${PRESSPEECH_RELEASE_ACTION_LOG}"; done' \
    'printf "\\n" >>"${PRESSPEECH_RELEASE_ACTION_LOG}"' \
    >"${scratch}/ship-swift.sh"
  chmod 0755 "${scratch}/ship-swift.sh"

  export PRESSPEECH_RELEASE_ACTION_LOG="${action_log}"
  run_release_action "${scratch}" patch
  run_release_action "${scratch}" minor
  run_release_action "${scratch}" major
  run_release_action "${scratch}" version:1.2.3
  run_release_action "${scratch}" cask-only:1.2.3

  printf '%s\n' \
    '0' \
    '1 <--minor>' \
    '1 <--major>' \
    '2 <--version> <1.2.3>' \
    '2 <--cask-only> <1.2.3>' \
    >"${expected_log}"
  diff -u "${expected_log}" "${action_log}"
  [[ "$(resolved_exit_code 0 1)" -eq 1 ]]
  [[ "$(resolved_exit_code 7 1)" -eq 7 ]]
  echo "Mac release worker self-test passed."
)

if [[ "${1:-}" == --self-test ]]; then
  [[ $# -eq 1 ]] || exit 2
  self_test_release_actions
  exit 0
fi

maintainer_root="${HOME}/Library/Application Support/PresspeechMaintainer"
state_root="${maintainer_root}/releases"
state_root="${PRESSPEECH_RELEASE_STATE_ROOT:-${state_root}}"
request_root="${state_root}/requests"
# macOS can leave a background LaunchAgent's binaries stuck in dyld when they
# live on a provenance-marked external volume. Dedicated internal-disk clones
# also isolate unattended releases from the developer's interactive checkout.
checkout_root="${maintainer_root}/checkouts"
repository="${checkout_root}/presspeech"
tap="${checkout_root}/homebrew-presspeech"
repository_url=https://github.com/rcourtman/presspeech.git
tap_url=https://github.com/rcourtman/homebrew-presspeech.git
mkdir -p "${request_root}" "${checkout_root}"

shopt -s nullglob dotglob
entries=("${request_root}"/*)
[[ ${#entries[@]} -gt 0 ]] || exit 0
request="$(printf '%s\n' "${entries[@]}" | sort | head -1)"
request_name="$(basename "${request}")"
if [[ ! "${request_name}" =~ ^([0-9]{8}T[0-9]{6}Z-[0-9]+)\.request$ ]]; then
  rejected="${state_root}/rejected-$(date -u +%Y%m%dT%H%M%SZ)-$$"
  mv "${request}" "${rejected}"
  echo "Rejected malformed release request: ${request_name}" >&2
  exit 2
fi
request_id="${BASH_REMATCH[1]}"

result="${state_root}/${request_id}.result"
log="${state_root}/${request_id}.log"
active="${state_root}/${request_id}.active"
action="$(head -1 "${request}")"
mv "${request}" "${active}"

final_status=1
finish() {
  observed_status=$?
  trap - EXIT
  exit_code="$(resolved_exit_code "${observed_status}" "${final_status}")"
  result_tmp="${result}.tmp"
  printf 'exit_code=%s\nfinished_at=%s\n' \
    "${exit_code}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"${result_tmp}"
  mv "${result_tmp}" "${result}"
  rm -f "${active}"
  exit "${exit_code}"
}
trap finish EXIT
exec > >(tee -a "${log}") 2>&1
set -e

echo "request_id=${request_id}"
echo "action=${action}"
echo "started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)"

check_credentials() {
  gh api user --jq .login
  security find-identity -v -p codesigning | grep -q 'Developer ID Application:'
  xcrun notarytool history --keychain-profile presspeech-notary >/dev/null
}

ensure_checkout() {
  local checkout_url="$1"
  local checkout="$2"
  if [[ -e "${checkout}" && ! -d "${checkout}/.git" ]]; then
    echo "Release checkout path exists but is not a Git repository: ${checkout}" >&2
    return 1
  fi
  if [[ ! -d "${checkout}/.git" ]]; then
    git clone --origin origin "${checkout_url}" "${checkout}"
  fi
  [[ "$(git -C "${checkout}" remote get-url origin)" == "${checkout_url}" ]] || {
    echo "Release checkout has an unexpected origin: ${checkout}" >&2
    return 1
  }
}

ensure_release_checkouts() {
  ensure_checkout "${repository_url}" "${repository}"
  ensure_checkout "${tap_url}" "${tap}"
}

check_release_entrypoint() {
  (cd "${repository}" && /bin/bash ./ship-swift.sh --self-test)
}

check_release_runtime() {
  (cd "${repository}/swift" && swift run -c debug Presspeech --self-test all)
}

prepare_checkout() {
  local checkout="$1"
  git -C "${checkout}" update-index --refresh >/dev/null 2>&1 || true
  [[ "$(git -C "${checkout}" branch --show-current)" == main ]]
  git -C "${checkout}" diff --quiet
  git -C "${checkout}" diff --cached --quiet
  [[ -z "$(git -C "${checkout}" ls-files --others --exclude-standard)" ]]
  git -C "${checkout}" fetch --prune origin main
  git -C "${checkout}" merge --ff-only origin/main
}

case "${action}" in
  doctor)
    check_credentials
    ensure_release_checkouts
    prepare_checkout "${repository}"
    prepare_checkout "${tap}"
    check_release_entrypoint
    check_release_runtime
    echo "release-worker=ready"
    ;;
  patch|minor|major|version:*|cask-only:*)
    check_credentials
    ensure_release_checkouts
    prepare_checkout "${repository}"
    prepare_checkout "${tap}"
    check_release_entrypoint
    run_release_action "${repository}" "${action}"
    ;;
  *)
    echo "Unsupported release action: ${action}" >&2
    final_status=2
    exit 2
    ;;
esac
final_status=0
